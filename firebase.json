{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "อ่านก่อน-ขึ้นระบบ.txt", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
